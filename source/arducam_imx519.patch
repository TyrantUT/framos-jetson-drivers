+static int imx519_set_mode(struct tegracam_device *tc_dev)
+{
+	struct imx519 *priv = (struct imx519 *)tegracam_get_privdata(tc_dev);
+	struct camera_common_data *s_data = tc_dev->s_data;
+
+	int err = 0;
+
+	dev_dbg(tc_dev->dev, "%s:\n", __func__);
+
+	err = imx519_write_table(priv, mode_table[IMX519_MODE_COMMON]);
+	if (err)
+		return err;
+
+	err = imx519_write_table(priv, mode_table[s_data->mode]);
+	if (err)
+		return err;
+
+	return 0;
+}
