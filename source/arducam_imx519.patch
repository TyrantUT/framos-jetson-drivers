+static inline void imx519_get_frame_length_regs(imx519_reg * regs,
+						u32 frame_length)
+{
+	regs->addr = IMX519_FRAME_LENGTH_ADDR_MSB;
+	regs->val = (frame_length >> 8) & 0xff;
+	(regs + 1)->addr = IMX519_FRAME_LENGTH_ADDR_LSB;
+	(regs + 1)->val = (frame_length) & 0xff;
+}
+
+static inline void imx519_get_coarse_integ_time_regs(imx519_reg * regs,
+						     u32 coarse_time)
+{
+	regs->addr = IMX519_COARSE_INTEG_TIME_ADDR_MSB;
+	regs->val = (coarse_time >> 8) & 0xff;
+	(regs + 1)->addr = IMX519_COARSE_INTEG_TIME_ADDR_LSB;
+	(regs + 1)->val = (coarse_time) & 0xff;
+}
+
+static inline void imx519_get_gain_reg(imx519_reg * reg, u16 gain)
+{
+	reg->addr = IMX519_ANALOG_GAIN_ADDR_MSB;
+	reg->val = (gain >> IMX519_SHIFT_8_BITS) & IMX519_MASK_LSB_2_BITS;
+
+	(reg + 1)->addr = IMX519_ANALOG_GAIN_ADDR_LSB;
+	(reg + 1)->val = (gain) & IMX519_MASK_LSB_8_BITS;
+}
+
+static inline int imx519_read_reg(struct camera_common_data *s_data,
+				  u16 addr, u8 * val)
+{
+	int err = 0;
+	u32 reg_val = 0;
+
+	err = regmap_read(s_data->regmap, addr, &reg_val);
+	*val = reg_val & 0xff;
+
+	return err;
+}
+
+static inline int imx519_write_reg(struct camera_common_data *s_data,
+				   u16 addr, u8 val)
+{
+	int err = 0;
+
+	err = regmap_write(s_data->regmap, addr, val);
+	if (err)
+		dev_err(s_data->dev, "%s: i2c write failed, 0x%x = %x",
+			__func__, addr, val);
+
+	return err;
+}
