+					nvcsi@15a00000 {
+						num-channels = <2>;
+						#address-cells = <1>;
+						#size-cells = <0>;
+						channel@0 {
+							reg = <0>;
+							ports {
+								#address-cells = <1>;
+								#size-cells = <0>;
+								port@0 {
+									reg = <0>;
+									arducam_csi_in0: endpoint@0 {
+										port-index = <1>;
+										bus-width = <2>;
+										remote-endpoint = <&arducam_out0>;
+									};
+								};
+								port@1 {
+									reg = <1>;
+									arducam_csi_out0: endpoint@1 {
+										remote-endpoint = <&arducam_vi_in0>;
