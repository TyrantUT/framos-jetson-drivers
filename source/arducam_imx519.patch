+static int imx519_start_streaming(struct tegracam_device *tc_dev)
+{
+	struct imx519 *priv = (struct imx519 *)tegracam_get_privdata(tc_dev);
+
+	dev_dbg(tc_dev->dev, "%s:\n", __func__);
+	return imx519_write_table(priv, mode_table[IMX519_START_STREAM]);
+}
+
+static int imx519_stop_streaming(struct tegracam_device *tc_dev)
+{
+	int err;
+	struct imx519 *priv = (struct imx519 *)tegracam_get_privdata(tc_dev);
+
+	dev_dbg(tc_dev->dev, "%s:\n", __func__);
+	err = imx519_write_table(priv, mode_table[IMX519_STOP_STREAM]);
+
+	return err;
+}
