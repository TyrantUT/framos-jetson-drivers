/*
 * Copyright (c) 2024 Framos. All rights reserved.
 *
 * tegra234-p3767-camera-p3768-fr_fpa_a_p22-overlay.dts - FPA-A/P22 device tree
 * Modified to enable Framos sensor on CAM1 only. CAM0 is available for an additionalrefractored sensor.
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/clock/tegra234-clock.h>
#include <dt-bindings/gpio/tegra234-gpio.h>
#include <dt-bindings/tegra234-p3767-0000-common.h>


#define CAM_I2C_MUX	TEGRA234_AON_GPIO(CC, 3)
#define CAM0_RST	TEGRA234_MAIN_GPIO(H, 6)
#define CAM1_RST	TEGRA234_MAIN_GPIO(AC, 0)

/* TCA6408 Pxx bus-port define*/
#define PW_EN		0
#define CRESETB		1
#define XMASTER		3

/ {
	overlay-name = "Framos FPA-A/P22 (CAM0 enabled + IMX519)";
	jetson-header-name = "Jetson 24pin CSI Connector";
	compatible = JETSON_COMPATIBLE_P3768;

	fragment@0 {
		target-path = "/";
		__overlay__ {
			tegra-camera-platform {
				compatible = "nvidia, tegra-camera-platform";
				num_csi_lanes = <8>;
				max_lane_speed = <2500000>;
				min_bits_per_pixel = <10>;
				vi_peak_byte_per_pixel = <2>;
				vi_bw_margin_pct = <25>;
				max_pixel_rate = <7500000>;
				isp_peak_byte_per_pixel = <5>;
				isp_bw_margin_pct = <25>;
				modules {
					status = "okay";
					sensor_module0: module0 {
						status = "okay";
						position = "front";
						orientation = "1";
						drivernode0 {
							status = "okay";
							pcl_id = "v4l2_sensor";
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/arducam_imx519_a@1a";
						};
					};
					sensor_module1: module1 {
						status = "disabled";
						position = "centerright";
						orientation = "1";
						drivernode0 {
							status = "disabled";
							/* Declare PCL support driver (classically known as guid) */
							pcl_id = "v4l2_sensor";
						};
					};
				};
			};
			tegra-capture-vi {
				num-channels=<2>;
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					status = "okay";
					sensor_vi_port1: port@1 {
						reg = <1>;
						status = "okay";
						sensor_vi_in1: okay {
							status = "disabled";
							port-index = <1>;
							bus-width = <2>;
							remote-endpoint = <&sensor_csi_ch1_out>;
						};
					};
					sensor_vi_port2: port@2 {
						reg = <2>;
						status = "disabled";
						sensor_vi_in2: endpoint {
							status = "disabled";
							vc-id = <0>;
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&sensor_csi_ch2_out>;
						};
					};
				};
			};
		};
	};

	fragment@1 {
		target-path = "/bus@0";
		__overlay__ {
			host1x@13e00000 {
				nvcsi@15a00000 {
					num-channels=<2>;
					#address-cells = <1>;
					#size-cells = <0>;
					sensor_csi_ch1: channel@1 {
						reg = <1>;
						status = "okay";
						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							status = "okay";
							sensor_csi_ch1_port0: port@0 {
								reg = <0>;
								status = "okay";
								sensor_csi_ch1_in: endpoint@2 {
									status = "okay";
									port-index = <1>;
									bus-width = <2>;
									remote-endpoint = <&sensor_out_b>;
								};
							};
							sensor_csi_ch1_port1: port@1 {
								reg = <1>;
								status = "okay";
								sensor_csi_ch1_out: endpoint@3 {
									status = "okay";
									remote-endpoint = <&sensor_vi_in1>;
								};
							};
						};
					};
					sensor_csi_ch2: channel@2 {
						reg = <2>;
						status = "disabled";
						ports {
							#address-cells = <1>;
							#size-cells = <0>;
							status = "disabled";
							sensor_csi_ch2_port0: port@0 {
								reg = <0>;
								status = "disabled";
								sensor_csi_ch2_in: endpoint@4 {
									status = "disabled";
									port-index = <2>;
									bus-width = <4>;
								};
							};
							sensor_csi_ch2_port1: port@1 {
								reg = <1>;
								status = "disabled";
								sensor_csi_ch2_out: endpoint@5 {
									status = "disabled";
									remote-endpoint = <&sensor_vi_in2>;
								};
							};
						};
					};
				};

				vi0@15c00000 {
					dma-noncoherent;
				};

				vi0-thi@15f00000 {
					dma-noncoherent;
				};

				vi1@14c00000 {
					dma-noncoherent;
				};

				vi1-thi@14f00000 {
					dma-noncoherent;
				};
			};
			gpio@2200000 {
				camera-control-output-low {
					gpio-hog;
					output-low;
					gpios = <CAM0_RST 0>;
					label = "cam1-pwdn";
					status = "okay";
				};
				som_gpio_cam1_rst {
					gpio-hog;
					output-low;
					gpios = <CAM1_RST 0>;
					label = "cam1_rst";
					status = "okay";
				};
			};
			cam_i2cmux: cam_i2cmux {
				status = "okay";
				compatible = "i2c-mux-gpio";
				#address-cells = <1>;
				#size-cells = <0>;
				mux-gpios = <&gpio_aon CAM_I2C_MUX GPIO_ACTIVE_HIGH>;
				i2c-parent = <&cam_i2c>;
			};
		};
	};

	fragment@2 {
		target = <&cam_i2cmux>;
		__overlay__ {
			/* Channel connected to CAM0 */
			cam_i2cmux_i2c0: i2c@0 {
				status = "okay";
				reg = <0>;
				#address-cells = <1>;
				#size-cells = <0>;

				rbpcv2_imx219_a@10 {
					status = "disabled";
				};

				sensor_b: arducam_imx519_a@1a {
					reset-gpios = <&gpio CAM0_PWDN GPIO_ACTIVE_HIGH>;
					compatible = "arducam,imx519";
					/* I2C device address */
					reg = <0x1a>;
					/* V4L2 device node location */
					devnode = "video0";
					/* Physical dimensions of sensor */
					physical_w = "3.680";
					physical_h = "2.760";
					sensor_model = "imx519";
					use_sensor_mode_id = "false";

					mode0 { /* IMX519_MODE_4656x3496 */
						mclk_khz = "24000";
						num_lanes = "2";
						tegra_sinterface = "serial_b";
						phy_mode = "DPHY";
						discontinuous_clk = "no";
						dpcm_enable = "false";
						cil_settletime = "0";
						lane_polarity = "6";
						active_w = "4656";
						active_h = "3496";
						mode_type = "bayer";
						pixel_phase = "rggb";
						csi_pixel_bit_depth = "10";
						readout_orientation = "90";
						line_length = "12650";
						inherent_gain = "1";
						mclk_multiplier = "80";
						pix_clk_hz = "300000000";
						gain_factor = "16";
						framerate_factor = "1000000";
						exposure_factor = "1000000";
						min_gain_val = "16"; /* 1.00x */
						max_gain_val = "256"; /* 22x */
						step_gain_val = "1";
						default_gain = "16"; /* 1.00x */
						min_hdr_ratio = "1";
						max_hdr_ratio = "1";
						min_framerate = "2000000"; /* 2.0 fps */
						max_framerate = "9000000"; /* 9.0 fps */
						step_framerate = "1";
						default_framerate = "9000000"; /* 9.0 fps */
						min_exp_time = "13"; /* us */
						max_exp_time = "683709"; /* us */
						step_exp_time = "1";
						default_exp_time = "2495"; /* us */
						embedded_metadata_height = "2";
					};
					mode1 { /* IMX519_MODE_3840x2160 */
						mclk_khz = "24000";
						num_lanes = "2";
						tegra_sinterface = "serial_b";
						phy_mode = "DPHY";
						discontinuous_clk = "no";
						dpcm_enable = "false";
						cil_settletime = "0";
						lane_polarity = "6";
						active_w = "3840";
						active_h = "2160";
						mode_type = "bayer";
						pixel_phase = "rggb";
						csi_pixel_bit_depth = "10";
						readout_orientation = "90";
						line_length = "10486";
						inherent_gain = "1";
						mclk_multiplier = "80";
						pix_clk_hz = "300000000";
						gain_factor = "16";
						framerate_factor = "1000000";
						exposure_factor = "1000000";
						min_gain_val = "16"; /* 1.00x */
						max_gain_val = "256"; /* 22x */
						step_gain_val = "1";
						default_gain = "16"; /* 1.00x */
						min_hdr_ratio = "1";
						max_hdr_ratio = "1";
						min_framerate = "2000000"; /* 2.0 fps */
						max_framerate = "17000000"; /* 17.0 fps */
						step_framerate = "1";
						default_framerate = "17000000"; /* 17.0 fps */
						min_exp_time = "13"; /* us */
						max_exp_time = "683709"; /* us */
						step_exp_time = "1";
						default_exp_time = "2495"; /* us */
						embedded_metadata_height = "2";
					};
					mode2 { /* IMX519_MODE_1920X1080 */
						mclk_khz = "24000";
						num_lanes = "2";
						tegra_sinterface = "serial_b";
						phy_mode = "DPHY";
						discontinuous_clk = "no";
						dpcm_enable = "false";
						cil_settletime = "0";
						lane_polarity = "6";
						active_w = "1920";
						active_h = "1080";
						mode_type = "bayer";
						pixel_phase = "rggb";
						csi_pixel_bit_depth = "10";
						readout_orientation = "90";
						line_length = "6027";
						inherent_gain = "1";
						mclk_multiplier = "80";
						pix_clk_hz = "300000000";
						gain_factor = "16";
						framerate_factor = "1000000";
						exposure_factor = "1000000";
						min_gain_val = "16"; /* 1.00x */
						max_gain_val = "256"; /* 22x */
						step_gain_val = "1";
						default_gain = "16"; /* 1.00x */
						min_hdr_ratio = "1";
						max_hdr_ratio = "1";
						min_framerate = "2000000"; /* 2.0 fps */
						max_framerate = "60000000"; /* 60.0 fps */
						step_framerate = "1";
						default_framerate = "60000000"; /* 60.0 fps */
						min_exp_time = "13"; /* us */
						max_exp_time = "683709"; /* us */
						step_exp_time = "1";
						default_exp_time = "2495"; /* us */
						embedded_metadata_height = "2";
					};
					mode3 { /* IMX519_MODE_1280x720 */
						mclk_khz = "24000";
						num_lanes = "2";
						tegra_sinterface = "serial_b";
						phy_mode = "DPHY";
						discontinuous_clk = "no";
						dpcm_enable = "false";
						cil_settletime = "0";
						lane_polarity = "6";
						active_w = "1280";
						active_h = "720";
						mode_type = "bayer";
						pixel_phase = "rggb";
						csi_pixel_bit_depth = "10";
						readout_orientation = "90";
						line_length = "4336";
						inherent_gain = "1";
						mclk_multiplier = "80";
						pix_clk_hz = "300000000";
						gain_factor = "16";
						framerate_factor = "1000000";
						exposure_factor = "1000000";
						min_gain_val = "16"; /* 1.00x */
						max_gain_val = "256"; /* 22x */
						step_gain_val = "1";
						default_gain = "16"; /* 1.00x */
						min_hdr_ratio = "1";
						max_hdr_ratio = "1";
						min_framerate = "2000000"; /* 2.0 fps */
						max_framerate = "120000000"; /* 120.0 fps */
						step_framerate = "1";
						default_framerate = "120000000"; /* 120.0 fps */
						min_exp_time = "13"; /* us */
						max_exp_time = "683709"; /* us */
						step_exp_time = "1";
						default_exp_time = "2495"; /* us */
						embedded_metadata_height = "2";
					};
					ports {
						#address-cells = <1>;
						#size-cells = <0>;
						port@0 {
							reg = <0>;
							sensor_out_b: endpoint {
								vc-id = <0>;
								port-index = <1>;
								bus-width = <2>;
								remote-endpoint = <&sensor_csi_ch1_in>;
							};
						};
					};
				};
			};

			/* Channel connected to CAM1 */
			cam_i2cmux_i2c1: i2c@1 {
				status = "okay";
				reg = <1>;
				#address-cells = <1>;
				#size-cells = <0>;
				reset-gpios = <&gpio CAM1_RST GPIO_ACTIVE_HIGH>;
				xmaster-gpio = <&tca6408_20_cam_i2cmux_i2c1 XMASTER GPIO_ACTIVE_HIGH>;
				cresetb = <&tca6408_20_cam_i2cmux_i2c1 CRESETB GPIO_ACTIVE_HIGH>;
				pwdn-gpios = <&tca6408_20_cam_i2cmux_i2c1 PW_EN GPIO_ACTIVE_HIGH>;

				tca6408_20_cam_i2cmux_i2c1: tca6408@20 {
					compatible = "ti,tca6408";
					gpio-controller;
					#gpio-cells = <2>;
					reg = <0x20>;
					status = "okay";
					/* P0: PW_EN */
					tca6408_20_i2c1_pw_en {
						gpio-hog;
						output-high;
						gpios = <PW_EN 0>;
						label = "pw_en";
						status = "okay";
					};
					/* P1: CRESETB */
					tca6408_20_i2c1_cresetb {
						gpio-hog;
						output-high;
						gpios = <CRESETB 0>;
						label = "cresetb";
						status = "okay";
					};
					/* P3: XMASTER */
					tca6408_20_i2c1_xmaster {
						gpio-hog;
						output-low;
						gpios = <XMASTER 0>;
						label = "xmaster";
						status = "okay";
					};
				};
			};
		};
	};


};
