/*
 *
 * tegra234-p3767-camera-p3768-ar_imx519-cam0-2lane-overlay.dts - IMX519 sensor device tree
 */

/dts-v1/;
/plugin/;

#include <dt-bindings/tegra234-p3767-0000-common.h>


/ {
	overlay-name = "Arducam IMX519 CAM0 - 2 Lane";
	jetson-header-name = "Jetson 24pin CSI Connector";
	compatible = JETSON_COMPATIBLE_P3768;

	fragment@0 {
		target = <&sensor_module0>;
		__overlay__ {
			status = "okay";
			badge = "imx519_front_arducam";
			drivernode0 {
				status = "okay";
				/* Declare PCL support driver (classically known as guid) */
				devname = "imx519 10-001a";
				/* Declare the device-tree hierarchy to driver instance */
				sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/cam_i2cmux/i2c@0/arducam_imx519_a@1a";
			};
		};
	};

	fragment@1 {
		target = <&sensor_vi_port1>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@2 {
		target = <&sensor_vi_in1>;
		__overlay__ {
			status = "okay";
			bus-width = <2>;
		};
	};

	fragment@3 {
		target = <&sensor_csi_ch1>;
		__overlay__ {
			status = "okay";
			ports {
				status = "okay";
			};
		};
	};

	fragment@4 {
		target = <&sensor_csi_ch1_port0>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@5 {
		target = <&sensor_csi_ch1_in>;
		__overlay__ {
			status = "okay";
			bus-width = <2>;
			remote-endpoint = <&sensor_out_b>;
		};
	};

	fragment@6 {
		target = <&sensor_csi_ch1_port1>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@7 {
		target = <&sensor_csi_ch1_out>;
		__overlay__ {
			status = "okay";
		};
	};

	fragment@8 {
		target = <&cam_i2cmux_i2c0>;
		__overlay__ {
			rbpcv2_imx219_a@10 {
				status = "disabled";
			};

			sensor_b: arducam_imx519_a@1a {
				compatible = "arducam,imx519";
				reg = <0x1a>;
				
				devnode = "video0";
				physical_w = "3.680";
				physical_h = "2.760";
				sensor_model = "imx519";
				use_sensor_mode_id = "false";
				
				// --- MODE DEFINITION 0: 4656x3496 ---
				mode0 { 
					mclk_khz = "24000";
					num_lanes = "2";
					tegra_sinterface = "serial_b";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					lane_polarity = "6";
					active_w = "4656";
					active_h = "3496";
					mode_type = "bayer";
					pixel_phase = "rggb";
					csi_pixel_bit_depth = "10";
					readout_orientation = "90";
					line_length = "12650";
					inherent_gain = "1";
					mclk_multiplier = "80";
					pix_clk_hz = "300000000";
					gain_factor = "16";
					framerate_factor = "1000000";
					exposure_factor = "1000000";
					min_gain_val = "16";
					max_gain_val = "256";
					step_gain_val = "1";
					default_gain = "16";
					min_hdr_ratio = "1";
					max_hdr_ratio = "1";
					min_framerate = "2000000";
					max_framerate = "9000000";
					step_framerate = "1";
					default_framerate = "9000000";
					min_exp_time = "13";
					max_exp_time = "683709";
					step_exp_time = "1";
					default_exp_time = "2495";
					embedded_metadata_height = "2";
				};
				
				// --- MODE DEFINITION 1: 3840x2160 ---
				mode1 { 
					mclk_khz = "24000";
					num_lanes = "2";
					tegra_sinterface = "serial_b";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					lane_polarity = "6";
					active_w = "3840";
					active_h = "2160";
					mode_type = "bayer";
					pixel_phase = "rggb";
					csi_pixel_bit_depth = "10";
					readout_orientation = "90";
					line_length = "10486";
					inherent_gain = "1";
					mclk_multiplier = "80";
					pix_clk_hz = "300000000";
					gain_factor = "16";
					framerate_factor = "1000000";
					exposure_factor = "1000000";
					min_gain_val = "16";
					max_gain_val = "256";
					step_gain_val = "1";
					default_gain = "16";
					min_hdr_ratio = "1";
					max_hdr_ratio = "1";
					min_framerate = "2000000";
					max_framerate = "17000000";
					step_framerate = "1";
					default_framerate = "17000000";
					min_exp_time = "13";
					max_exp_time = "683709";
					step_exp_time = "1";
					default_exp_time = "2495";
					embedded_metadata_height = "2";
				};
				
				// --- MODE DEFINITION 2: 1920x1080 ---
				mode2 { 
					mclk_khz = "24000";
					num_lanes = "2";
					tegra_sinterface = "serial_b";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					lane_polarity = "6";
					active_w = "1920";
					active_h = "1080";
					mode_type = "bayer";
					pixel_phase = "rggb";
					csi_pixel_bit_depth = "10";
					readout_orientation = "90";
					line_length = "6027";
					inherent_gain = "1";
					mclk_multiplier = "80";
					pix_clk_hz = "300000000";
					gain_factor = "16";
					framerate_factor = "1000000";
					exposure_factor = "1000000";
					min_gain_val = "16";
					max_gain_val = "256";
					step_gain_val = "1";
					default_gain = "16";
					min_hdr_ratio = "1";
					max_hdr_ratio = "1";
					min_framerate = "2000000";
					max_framerate = "60000000";
					step_framerate = "1";
					default_framerate = "60000000";
					min_exp_time = "13";
					max_exp_time = "683709";
					step_exp_time = "1";
					default_exp_time = "2495";
					embedded_metadata_height = "2";
				};
				
				// --- MODE DEFINITION 3: 1280x720 ---
				mode3 {
					mclk_khz = "24000";
					num_lanes = "2";
					tegra_sinterface = "serial_b";
					phy_mode = "DPHY";
					discontinuous_clk = "no";
					dpcm_enable = "false";
					cil_settletime = "0";
					lane_polarity = "6";
					active_w = "1280";
					active_h = "720";
					mode_type = "bayer";
					pixel_phase = "rggb";
					csi_pixel_bit_depth = "10";
					readout_orientation = "90";
					line_length = "4336";
					inherent_gain = "1";
					mclk_multiplier = "80";
					pix_clk_hz = "300000000";
					gain_factor = "16";
					framerate_factor = "1000000";
					exposure_factor = "1000000";
					min_gain_val = "16";
					max_gain_val = "256";
					step_gain_val = "1";
					default_gain = "16";
					min_hdr_ratio = "1";
					max_hdr_ratio = "1";
					min_framerate = "2000000";
					max_framerate = "120000000";
					step_framerate = "1";
					default_framerate = "120000000";
					min_exp_time = "13";
					max_exp_time = "683709";
					step_exp_time = "1";
					default_exp_time = "2495";
					embedded_metadata_height = "2";
				};
				
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						sensor_out_b: endpoint {
							vc-id = <0>;
							port-index = <1>;
							bus-width = <2>;
							remote-endpoint = <&sensor_csi_ch1_in>;
						};
					};
				};
			};
		};
	};
};
